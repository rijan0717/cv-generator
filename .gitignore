# dependencies
node_modules/

# development TLS certificates (self-signed, never commit a private key)
certs/

# environment
.env
.env.local
.env.*.local
.env.bak*

# build output
dist/
build/

# generated load-test credentials (test accounts, but still passwords)
server/scripts/output/

# uploads (user generated)
server/uploads/*
!server/uploads/.gitkeep

# logs
logs/
*.log
npm-debug.log*

# test / coverage
coverage/

# editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# private uploads (company registration documents)
server/private-uploads/

# Third-party reference material kept for local planning only: large, and
# not ours to republish (see docs/plans/template-gallery/PLAN.md).
docs/plans/*/reference/
