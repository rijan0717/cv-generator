# Base URL of the Express API.
# Left empty during development so requests go through the Vite proxy
# (see vite.config.js) and share the browser origin.
VITE_API_BASE_URL=

# Google sign-in (optional). The same OAuth client ID as GOOGLE_CLIENT_ID in
# server/.env; leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
