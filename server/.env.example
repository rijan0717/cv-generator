# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Base URL of the React client (used by CORS and by Puppeteer for PDF export)
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local MongoDB during development. For deployment you may use a MongoDB Atlas
# connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/cv_generator

# ---------------------------------------------------------------------------
# Authentication (JWT stored in an httpOnly cookie)
# ---------------------------------------------------------------------------
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=cvg_token

# Short-lived token used only by the PDF print route
PRINT_TOKEN_SECRET=replace_me_with_another_long_random_string
PRINT_TOKEN_EXPIRES_IN=2m

# ---------------------------------------------------------------------------
# Admin seed account (npm run seed:admin) - never created via public register
# ---------------------------------------------------------------------------
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password1

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=2
